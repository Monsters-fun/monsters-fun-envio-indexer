# Auth
# To create or update a token visit https://envio.dev/app/api-tokens
# When configuring via the Envio dashboard, prefix keys with ENVIO_ (e.g. ENVIO_GCP_PROJECT_ID)
ENVIO_API_TOKEN="<YOUR-API-TOKEN>"

# Cloud Tasks configuration
GCP_PROJECT_ID=your-project-id
GCP_LOCATION=us-central1
GCP_QUEUE_NAME=payment-processing

# Service account credentials
# Recommended: paste the JSON payload (single line or heredoc) into this variable.
# Example: export GOOGLE_APPLICATION_CREDENTIALS_JSON="$(cat ./credentials-cloud.json)"
GOOGLE_APPLICATION_CREDENTIALS_JSON=""

# Optional legacy fallback: point to a local key file instead of inlining JSON.
# Leave blank when using GOOGLE_APPLICATION_CREDENTIALS_JSON.
GOOGLE_APPLICATION_CREDENTIALS=

# Backend configuration
BACKEND_URL=https://api.yourbackend.com

# Payment destinations
# ERC20 token payments destination (for CreatureBoringToken etc.)
PAYMENT_DESTINATION_ADDRESS=0xB783448d31Ce8768B1F296fa3541A297fC1353c7
# Native token (ETH on L2) payments destination (for predeploy 0x...800A)
PAYMENT_ETH_DESTINATION_ADDRESS=0x0000000000000000000000000000000000000000

# Feature toggles (defaults to true if unset)
PAYMENT_FORWARDING_ENABLED_GLOBAL=true
PAYMENT_FORWARDING_ERC20_ENABLED=true
PAYMENT_FORWARDING_ETH_ENABLED=true
