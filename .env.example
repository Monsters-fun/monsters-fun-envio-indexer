# ------------------------------------------------------------------------------
# Core indexer configuration
# ------------------------------------------------------------------------------

# GraphQL / backend endpoint used by default for webhook-style callbacks. Required.
BACKEND_URL=https://your-backend.example.com

# Primary Cloud Tasks queue/project used by the shared payment forwarding helpers.
# If you run everything under the same Google project, you can leave these set once.
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1
GCP_QUEUE_NAME=payments

# Service account credentials for Cloud Tasks authentication. You can either point
# to a local key file (GOOGLE_APPLICATION_CREDENTIALS) or inline the JSON payload
# as a base64 or raw JSON string (GOOGLE_APPLICATION_CREDENTIALS_JSON).
# Only one of these is required.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# GOOGLE_APPLICATION_CREDENTIALS_JSON=eyJ0eXBlIjoi... (optional alternative)

# Shared secret used by payment confirmation webhooks. Duel Trade and PVP Arena
# default to this value unless you override them in their own sections below.
PAYMENTS_CLOUD_TASKS_SECRET=replace-with-random-secret

# Payment confirmation scheduler toggle block height (for skipping pre-bootstrapped blocks).
PAYMENT_CONFIRMATION_MIN_BLOCK=0

# ------------------------------------------------------------------------------
# Duel Trade Core (Base Sepolia)
# ------------------------------------------------------------------------------

# Contract address to filter events against (lowercase preferred).
DUEL_TRADE_CORE_ADDRESS=0xfff5454a2231cfac95badd9563069f55a5fa88c9

# Backend endpoint that will receive /internal/indexer/events calls.
# Falls back to BACKEND_URL if left empty, but we recommend setting it explicitly.
DUEL_TRADE_CORE_BACKEND_URL=https://duel-trade-api.example.com

# Cloud Tasks queue / project / location dedicated to Duel Trade. If you reuse the
# global queue, keep these values aligned with the root settings.
DUEL_TRADE_CORE_QUEUE_NAME=duel-trade
# Optional overrides; uncomment if Duel Trade runs in a different GCP project/setup.
# DUEL_TRADE_CORE_GCP_PROJECT_ID=duel-trade-project
# DUEL_TRADE_CORE_GCP_LOCATION=us-central1
# DUEL_TRADE_CORE_GOOGLE_APPLICATION_CREDENTIALS=/path/to/duel-trade-service-account.json
# DUEL_TRADE_CORE_GOOGLE_APPLICATION_CREDENTIALS_JSON=eyJ0eXBlIjoi...

# Shared secret expected by the Duel Trade backend (x-internal-secret header).
# Defaults to PAYMENTS_CLOUD_TASKS_SECRET when left blank.
DUEL_TRADE_CORE_INDEXER_SECRET=replace-with-duel-trade-secret

# Minimum block to start indexing (helps skip historical noise; keep 0 for all history).
DUEL_TRADE_CORE_MIN_BLOCK=0

# ------------------------------------------------------------------------------
# PVP Arena
# ------------------------------------------------------------------------------

# Contract address used to filter arena events.
PVP_ARENA_ADDRESS=0x95ef8b998c504410cbc101a2fc93a134a30ba619

# Backend endpoint for arena notifications. Defaults to BACKEND_URL when empty.
PVP_ARENA_BACKEND_URL=https://monsters-backend.example.com

# Cloud Tasks queue used for arena events (defaults to the global payments queue if reused).
PVP_ARENA_QUEUE_NAME=pvp-arena

# Secret forwarded via x-monsters-cloudtasks-secret. Defaults to PAYMENTS_CLOUD_TASKS_SECRET.
PVP_ARENA_CLOUD_TASKS_SECRET=replace-with-pvp-secret

# Minimum block height to process arena events from (0 to index everything).
PVP_ARENA_MIN_BLOCK=0

# ------------------------------------------------------------------------------
# Notes
# ------------------------------------------------------------------------------

# • Every variable also supports the ENVIO_ prefix (e.g. ENVIO_BACKEND_URL) which can be
#   handy when running under the Envio CLI or hosted service.
# • Remove or comment out any credentials before committing this file.
# • Copy this template to .env (or provide the same values via your deployment tooling).
